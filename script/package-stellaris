#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "$0")/.."

: "${RELEASE_VERSION:?RELEASE_VERSION must be set}"

target_triple="aarch64-apple-darwin"
bundle_dir="target/${target_triple}/release/bundle/osx"
shopt -s nullglob
app_paths=("${bundle_dir}"/*.app)
shopt -u nullglob

if [ "${#app_paths[@]}" -ne 1 ]; then
    echo "Error: expected one application bundle in ${bundle_dir}. Run script/build-stellaris first."
    exit 1
fi

app_path=${app_paths[0]}

out_dir="target/release"
archive_name="Stellaris-${RELEASE_VERSION}-aarch64-macos.zip"
mkdir -p "$out_dir"
rm -f "${out_dir}/${archive_name}"

ditto -c -k --keepParent "$app_path" "${out_dir}/${archive_name}"
printf 'Created unsigned macOS archive: %s\n' "${out_dir}/${archive_name}"
